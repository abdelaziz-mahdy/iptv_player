<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App sandbox is intentionally disabled for local debug builds so
	     flutter_secure_storage's keychain works under ad-hoc signing (no paid
	     Apple Developer team). Release.entitlements keeps the sandbox +
	     keychain-access-groups for a properly signed store build. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
